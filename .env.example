# mindfork-office .env.example
# 對應 reports/architecture/memory-webapp-architecture-v2-20260509.md §B.3
#
# 真實值放 .env.local（不入 git）或 Vercel Project Settings → Environment Variables。
# 此檔不放任何真實值，只放佔位 + 取得方式說明。

# ---------------------------------------------------------------------------
# Turso（libSQL）
# ---------------------------------------------------------------------------
# 取得方式：
#   1. https://app.turso.tech/ → 選 rotarycredit DB → "Connect" tab
#   2. Database URL → 填到 TURSO_DATABASE_URL（也別名 TURSO_URL，向後相容）
#   3. "Generate Token" → 填到 TURSO_AUTH_TOKEN（別名 TURSO_TOKEN）
#
# Canonical: TURSO_DATABASE_URL / TURSO_AUTH_TOKEN（Turso 官方 SDK 命名）
# Alias    : TURSO_URL / TURSO_TOKEN（v2 doc + .env.local 既有命名，向後相容）
# 真相來源（lib/turso.ts）：先讀 _DATABASE_URL/_AUTH_TOKEN，fallback 到 _URL/_TOKEN
# 新環境一律用 canonical；既有 .env.local 不動仍可用 alias，但建議過渡期後改 canonical
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=eyJ...your_token_here

# ---------------------------------------------------------------------------
# Wiki / Memory Webapp HMAC secrets
# ---------------------------------------------------------------------------
# 取得方式：本地隨機生成（一次性）
#   openssl rand -hex 32
#   或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Canonical: WIKI_HMAC_SECRET（.env.example + lib/wiki-hmac.ts 主名）
# Alias    : MEMORY_TOKEN_SECRET（v2 doc 命名，向後相容）
# 真相來源（lib/wiki-hmac.ts getTokenSecret()）：先 WIKI_HMAC_SECRET，fallback 到 MEMORY_TOKEN_SECRET
# 用於：/api/wiki/token/issue 簽 token、所有受 token 保護 endpoint 驗 token
# 安全等級：等同 root credential — 外洩可偽造任何老大 token
# rotation：rotate 後既有 token 全部失效（DB 不刪、sig 驗不過）
# 兩個命名同時設不同值會選 WIKI_HMAC_SECRET，請只設一個避免混淆
WIKI_HMAC_SECRET=replace_with_64_hex_chars

# MEMORY_AGENT_HMAC_SECRET（單一命名，無 alias）
# 用於：subagent → /api/wiki/submit 的 server-to-server HMAC（lib/wiki-hmac.ts getAgentSecret()）
# 與 WIKI_HMAC_SECRET 分離（避免單一 secret 外洩造成全面淪陷，v2 §C.5）
MEMORY_AGENT_HMAC_SECRET=replace_with_another_64_hex_chars

# ---------------------------------------------------------------------------
# Admin auth（既有，Vercel 已設）
# ---------------------------------------------------------------------------
# admin-auth.ts 用，token issue/revoke endpoint 走此認證。
# Vercel Project Settings 已設，本地開發可填 dev 值。
ADMIN_AUTH_SECRET=at_least_16_chars_for_dev
ADMIN_PASSWORD=your_admin_password

# ---------------------------------------------------------------------------
# Telegram（既有 mindfork bot）
# ---------------------------------------------------------------------------
# 取得方式：
#   TELEGRAM_BOT_TOKEN：找 @BotFather /mybots → 選 bot → API Token
#   TELEGRAM_BOSS_CHAT_ID：傳訊息給 bot 後 GET https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOSS_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# 既有的 mindfork-office 設定（P1-2 不動，列出供 reference）
# ---------------------------------------------------------------------------
# MINDFORK_API_KEY=mf-api-2026   # 如有自定 API key 機制
